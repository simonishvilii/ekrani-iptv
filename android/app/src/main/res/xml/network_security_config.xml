<?xml version="1.0" encoding="utf-8"?>
<!-- IPTV playlists, guides and streams are very often plain http:// -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
